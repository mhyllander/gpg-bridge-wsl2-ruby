[Unit]
Description=GPG Relay Agent
Requires=gpg-relay-agent-socket.socket
Requires=gpg-relay-agent-extra-socket.socket
Requires=gpg-relay-agent-browser-socket.socket
Wants=gpg-relay-agent-ssh-socket.socket
After=gpg-relay-agent-socket.socket gpg-relay-agent-extra-socket.socket gpg-relay-agent-browser-socket.socket gpg-relay-agent-ssh-socket.socket

[Service]
Type=simple
ExecStart=/path/to/gpg_relay_wsl --systemd --enable-ssh-support --mode=mirrored
Environment='PATH=/usr/local/bin:/usr/bin:/bin:/mnt/c/Program Files/GnuPG/bin'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpg-relay-agent

[Install]
WantedBy=default.target
